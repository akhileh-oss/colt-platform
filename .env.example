# =============================================================================
# Colt — example environment configuration
#
# Copy to `.env` and fill in locally:  cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed (CLAUDE.md §7.2).
# This file contains PLACEHOLDERS ONLY — never put a real credential here.
# Production secrets come from a managed secrets service, not from a file.
# =============================================================================

# -----------------------------------------------------------------------------
# APP_
# -----------------------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
APP_NAME=colt
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
APP_WEB_BASE_URL=http://localhost:3000
# Signs session state. Generate per environment: `openssl rand -hex 32`
APP_SECRET_KEY=change-me-generate-a-random-32-byte-hex-value

# -----------------------------------------------------------------------------
# DATABASE_
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://colt:colt@localhost:5432/colt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# REDIS_
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# TEMPORAL_
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=colt-main

# -----------------------------------------------------------------------------
# S3_  (MinIO locally)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_RESEARCH=colt-research
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# AUTH_  (Keycloak locally; any OIDC provider in production — CLAUDE.md §26.1)
# -----------------------------------------------------------------------------
AUTH_ISSUER_URL=http://localhost:8081/realms/colt
AUTH_CLIENT_ID=colt-api
AUTH_CLIENT_SECRET=change-me
AUTH_AUDIENCE=colt-api
AUTH_JWKS_CACHE_SECONDS=300

# -----------------------------------------------------------------------------
# ANTHROPIC_
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3
# Model IDs are configuration, never hard-coded in business logic (CLAUDE.md §14.1).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STANDARD=claude-sonnet-5
ANTHROPIC_MODEL_DEEP=claude-opus-5
ANTHROPIC_MODEL_STRATEGIC=claude-opus-5

# -----------------------------------------------------------------------------
# EMAIL_  (Mailpit locally — CLAUDE.md §29)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailpit
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=outbound@example.test
EMAIL_FROM_NAME=Colt
EMAIL_API_KEY=

# -----------------------------------------------------------------------------
# CRM_
# -----------------------------------------------------------------------------
CRM_PROVIDER=fake                  # fake | hubspot | salesforce
CRM_API_KEY=
CRM_BASE_URL=

# -----------------------------------------------------------------------------
# SEARCH_
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=fake
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# ENRICHMENT_
# -----------------------------------------------------------------------------
ENRICHMENT_PROVIDER=fake
ENRICHMENT_API_KEY=
ENRICHMENT_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# OBSERVABILITY_
# -----------------------------------------------------------------------------
OBSERVABILITY_OTEL_ENDPOINT=http://localhost:4317
OBSERVABILITY_SERVICE_NAME=colt-api
OBSERVABILITY_TRACE_SAMPLE_RATE=1.0
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# SECURITY_
# -----------------------------------------------------------------------------
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000
SECURITY_MAX_REQUEST_BYTES=1048576
SECURITY_HTTP_FETCH_TIMEOUT_SECONDS=15
SECURITY_HTTP_MAX_REDIRECTS=3
SECURITY_HTTP_MAX_RESPONSE_BYTES=5242880
# SSRF defence — block private/loopback/link-local/metadata targets (CLAUDE.md §33).
SECURITY_BLOCK_PRIVATE_NETWORKS=true

# -----------------------------------------------------------------------------
# FEATURE_
# -----------------------------------------------------------------------------
# Local development performs NO real external side effects (CLAUDE.md §6.4).
#
# Naming: §6.4 writes these bare (REAL_EMAIL), while §7.3 requires every setting to sit under a
# category prefix. The two sections conflict. We prefix, so these belong to the FEATURE_ group
# and load through one settings model. Do not rename them to match §6.4 literally — the bare
# form was considered and rejected.
FEATURE_REAL_EMAIL=false
FEATURE_REAL_CRM=false
FEATURE_REAL_CALENDAR=false
FEATURE_REAL_SOCIAL=false
# Emergency kill switches (CLAUDE.md §72).
FEATURE_OUTBOUND_ENABLED=false
FEATURE_AGENTS_ENABLED=true

# -----------------------------------------------------------------------------
# RATE_LIMIT_
# -----------------------------------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_OUTBOUND_PER_ORG_PER_DAY=200
RATE_LIMIT_OUTBOUND_PER_ORG_PER_HOUR=50
RATE_LIMIT_AGENT_RUNS_PER_ORG_PER_HOUR=500
